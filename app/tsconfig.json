{
	"compilerOptions": {
		"target": "ESNext",
		"module": "nodenext",
		"moduleResolution": "nodenext",

		"outDir": "./dist",
		"rootDir": "./src",

		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules"]
}
